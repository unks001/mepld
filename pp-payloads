Verification Tool
===================================
Quick browser bookmarklet to test PP on the target:

javascript



javascript:(function(){
  var results = [];
  ['__proto__','constructor'].forEach(function(k){
    try {
      var o = {}; o[k] = {pptest: 'YES'};
      if(Object.prototype.pptest === 'YES') results.push(k + ' path: ✅ POLLUTED');
      delete Object.prototype.pptest;
    } catch(e) { results.push(k + ' path: ❌ Blocked'); }
  });
  alert(results.join('\n'));
})();
